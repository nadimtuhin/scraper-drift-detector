{
  "name": "Ecommerce Product Page",
  "version": "1.0.0",
  "maxAllowedDriftPercent": 0,
  "selectors": {
    "title": {
      "selector": "h1.product-title",
      "required": true,
      "minCount": 1
    },
    "price": {
      "selector": "span.price-current",
      "required": true,
      "pattern": "^\\$[0-9]+(\\.[0-9]{2})?$"
    },
    "sku": {
      "selector": "meta[itemprop='sku']",
      "attribute": "content",
      "required": false
    },
    "availability": {
      "selector": ".in-stock-badge",
      "required": false
    },
    "buyButton": {
      "selector": "button.btn-add-to-cart",
      "required": true
    }
  }
}
